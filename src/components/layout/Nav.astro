---
import ButtonLink from '../base/ButtonLink.astro';
---
<header class="w-full">
  <nav class="flex items-center justify-between px-6 py-5 max-w-6xl mx-auto">
    <a href="/" class="flex items-center leading-none select-none">
      <img src="/logo.svg" alt="tools.alvaroso.dev" width="34" height="32" />
    </a>
    <ButtonLink href="/about" class="text-base">
      About
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9 6.65032C9 6.65032 15.9383 6.10759 16.9154 7.08463C17.8924 8.06167 17.3496 15 17.3496 15M16.5 7.5L6.5 17.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
      </svg>
    </ButtonLink>
  </nav>
</header>
