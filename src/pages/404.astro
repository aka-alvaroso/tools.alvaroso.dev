---
import Layout from '../components/layout/Layout.astro';
import ButtonLink from '../components/base/ButtonLink.astro';
---

<Layout title="404 — Not Found">
  <div class="flex flex-col items-center justify-center flex-1 px-6 py-32 text-center">
    <p class="text-[120px] font-black leading-none text-dark/10 select-none">404</p>
    <h1 class="text-2xl font-black mt-2">Page not found</h1>
    <p class="text-dark/50 mt-2 mb-8">That URL doesn't exist here.</p>
    <ButtonLink href="/" variant="link">Back to tools</ButtonLink>
  </div>
</Layout>
