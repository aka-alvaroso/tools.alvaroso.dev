---
import Layout from '../components/layout/Layout.astro';
import ToolCard from '../components/ui/ToolCard.astro';
import FilterPill from '../components/ui/FilterPill.astro';
import NotifySection from '../components/ui/NotifySection';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// Inline + annotate the hash generator active SVG so GSAP can target its parts
let hashActiveSvg = readFileSync(
  join(process.cwd(), 'public', 'Cards', 'hash_generator_active.svg'), 'utf-8'
);
hashActiveSvg = hashActiveSvg
  // Fill container
  .replace('width="251" height="180"', 'style="width:100%;height:100%;display:block;"')
  // Arrow path (unique: fill="#48ACF0")
  .replace('<path d="M199.269 102.156L199.606', '<path id="hash-arrow" d="M199.269 102.156L199.606')
  // Your-file pill group
  .replace('<g clip-path=', '<g id="hash-pill" clip-path=')
  // Document card outline
  .replace('transform="rotate(-9.43371)"', 'id="hash-doc-bg" transform="rotate(-9.43371)"')
  // Green text lines
  .replace('transform="rotate(-9.43371 20 43.0702)"', 'id="hash-green-1" transform="rotate(-9.43371 20 43.0702)"')
  .replace('transform="rotate(-9.43371 24 59.0702)"', 'id="hash-green-2" transform="rotate(-9.43371 24 59.0702)"')
  // Your-file text path
  .replace('<path d="M15.2343 19.418', '<path id="hash-text" d="M15.2343 19.418');

// ── Email Analyzer: annotate active SVG for GSAP ─────────────────────────────
let emailActiveSvg = readFileSync(
  join(process.cwd(), 'public', 'Cards', 'email_analyzer_active.svg'), 'utf-8'
);
emailActiveSvg = emailActiveSvg
  .replace('width="268" height="180"', 'style="width:100%;height:100%;display:block;"')
  // Text blocks (reading order: top row L→R, then down)
  .replace('<rect x="18.5" y="22" width="49"',   '<rect id="em-red"   x="18.5" y="22" width="49"')
  .replace('<rect x="73.5" y="22" width="114"',  '<rect id="em-t1"    x="73.5" y="22" width="114"')
  .replace('<rect x="18.5" y="48" width="197"',  '<rect id="em-t2"    x="18.5" y="48" width="197"')
  .replace('<rect x="18.5" y="74" width="49"',   '<rect id="em-t3"    x="18.5" y="74" width="49"')
  .replace('<rect x="73.5" y="74" width="77"',   '<rect id="em-green" x="73.5" y="74" width="77"')
  .replace('<rect x="156.5" y="74" width="65"',  '<rect id="em-t4"    x="156.5" y="74" width="65"')
  .replace('<rect x="18.5" y="100" width="127"', '<rect id="em-t5"    x="18.5" y="100" width="127"')
  // Wrap magnifier paths in a moveable group
  .replace('<path d="M304.5 196L263.5 155"',     '<g id="em-magnifier"><path id="em-handle" d="M304.5 196L263.5 155"')
  .replace('<path d="M221.625 171.917C',          '<path id="em-lens" d="M221.625 171.917C')
  // Close the magnifier group before the clip-path group closes
  .replace(/stroke-linejoin="round"\/>\s*<\/g>\s*\n<defs>/, 'stroke-linejoin="round"/>\n</g>\n</g>\n<defs>');

// ── Color Converter: inline both idle and active SVGs ────────────────────────
const ccvInlineStyle = 'style="width:100%;height:100%;display:block;"';
let ccvIdleSvg = readFileSync(
  join(process.cwd(), 'public', 'Cards', 'color_converter_idle.svg'), 'utf-8'
);
ccvIdleSvg = ccvIdleSvg.replace('width="268" height="180"', ccvInlineStyle);

let ccvAnimSvg = readFileSync(
  join(process.cwd(), 'public', 'Cards', 'color_converter_active.svg'), 'utf-8'
);
ccvAnimSvg = ccvAnimSvg.replace('width="268" height="180"', ccvInlineStyle);

// ── Color Contrast: annotate active SVG for GSAP ─────────────────────────────
let ccActiveSvg = readFileSync(
  join(process.cwd(), 'public', 'Cards', 'color_contrast_active.svg'), 'utf-8'
);
ccActiveSvg = ccActiveSvg
  .replace('width="268" height="180"', 'style="width:100%;height:100%;display:block;"')
  .replace('<path d="M54.3772',  '<path id="cc-red"    d="M54.3772')
  .replace('<path d="M85.7339',  '<path id="cc-green"  d="M85.7339')
  .replace('<path d="M138.924',  '<path id="cc-yellow" d="M138.924')
  .replace('<path d="M208.355',  '<path id="cc-blue"   d="M208.355')
  .replace('<circle cx="202.5"', '<circle id="cc-circle" cx="202.5"');

// ── Pomodoro: annotate active SVG so GSAP can spin the clock hands ───────────
let pomodoroActiveSvg = readFileSync(
  join(process.cwd(), 'public', 'Cards', 'pomodoro_active.svg'), 'utf-8'
);
pomodoroActiveSvg = pomodoroActiveSvg
  .replace('width="234" height="180"', 'style="width:100%;height:100%;display:block;"')
  .replace('<path d="M135.778 114.621L122.889 101.732"', '<path id="pomo-hand-short" d="M135.778 114.621L122.889 101.732"')
  .replace('<path d="M117.5 86L117.5 53"', '<path id="pomo-hand-long" d="M117.5 86L117.5 53"');

// ── Password Tools: composite SVG from the three active states ────────────────
function pwExtractPaths(svg: string) {
  const paths: string[] = [];
  const re = /<path([^>]+)\/>/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(svg)) !== null) paths.push(m[1].trim());
  return paths;
}
function pwGetD(attrs: string) { return attrs.match(/d="([^"]*)"/)?.[1] ?? ''; }

const [pw1Raw, pw2Raw, pw3Raw] = ['active1', 'active2', 'active3'].map(n =>
  readFileSync(join(process.cwd(), 'public', 'Cards', `password_tools_${n}.svg`), 'utf-8')
);
const pw1P = pwExtractPaths(pw1Raw);
const pw2P = pwExtractPaths(pw2Raw);
const pw3P = pwExtractPaths(pw3Raw);

// Asterisk d-values: same across all three states (indices 0-3)
const astD = pw1P.slice(0, 4).map(pwGetD);
// Icon fill-paths (index 4 in each)
const iconD = [pw1P[4], pw2P[4], pw3P[4]].map(pwGetD);
// Label fill-paths (index 5 in each)
const labelD = [pw1P[5], pw2P[5], pw3P[5]].map(pwGetD);

const pwAnimSvg = `<svg viewBox="0 0 268 180" style="width:100%;height:100%;display:block;" fill="none" xmlns="http://www.w3.org/2000/svg">
<path id="pw-ast-1" d="${astD[0]}" stroke="#23CE6B" stroke-width="7"/>
<path id="pw-ast-2" d="${astD[1]}" stroke="#23CE6B" stroke-width="7"/>
<path id="pw-ast-3" d="${astD[2]}" stroke="#23CE6B" stroke-width="7"/>
<path id="pw-ast-4" d="${astD[3]}" stroke="#23CE6B" stroke-width="7"/>
<path id="pw-icon-easy"   d="${iconD[0]}" fill="#23CE6B"/>
<path id="pw-icon-medium" d="${iconD[1]}" fill="#FFDB4D" style="opacity:0"/>
<path id="pw-icon-hard"   d="${iconD[2]}" fill="#E63841" style="opacity:0"/>
<path id="pw-label-easy"   d="${labelD[0]}" fill="#23CE6B"/>
<path id="pw-label-medium" d="${labelD[1]}" fill="#FFDB4D" style="opacity:0"/>
<path id="pw-label-hard"   d="${labelD[2]}" fill="#E63841" style="opacity:0"/>
</svg>`;

const categories = [
  { label: 'All',          value: 'all',          color: '#131313' },
  { label: 'Security',     value: 'security',     color: '#E63841' },
  { label: 'Design',       value: 'design',       color: '#23CE6B' },
  { label: 'Develop',      value: 'develop',      color: '#48ACF0' },
  { label: 'Data',         value: 'data',         color: '#FFDB4D' },
  { label: 'Productivity', value: 'productivity', color: '#131313' },
];

// Hugeicons icon SVGs — viewBox="0 0 24 24", 20×20, stroke-width 1.5
const icon = {
  hash:     `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 21L18 3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M6 21L10 3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M5 8H21" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M3 16H19" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  key:      `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15.5 14.5C18.8137 14.5 21.5 11.8137 21.5 8.5C21.5 5.18629 18.8137 2.5 15.5 2.5C12.1863 2.5 9.5 5.18629 9.5 8.5C9.5 9.38041 9.68962 10.2165 10.0303 10.9697L2.5 18.5V21.5H5.5V19.5H7.5V17.5H9.5L13.0303 13.9697C13.7835 14.3104 14.6196 14.5 15.5 14.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M17.5 6.5L16.5 7.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  mail:     `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 6L8.91302 9.91697C11.4616 11.361 12.5384 11.361 15.087 9.91697L22 6" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/><path d="M2.01577 13.4756C2.08114 16.5412 2.11383 18.0739 3.24496 19.2094C4.37608 20.3448 5.95033 20.3843 9.09883 20.4634C11.0393 20.5122 12.9607 20.5122 14.9012 20.4634C18.0497 20.3843 19.6239 20.3448 20.7551 19.2094C21.8862 18.0739 21.9189 16.5412 21.9842 13.4756C22.0053 12.4899 22.0053 11.5101 21.9842 10.5244C21.9189 7.45886 21.8862 5.92609 20.7551 4.79066C19.6239 3.65523 18.0497 3.61568 14.9012 3.53657C12.9607 3.48781 11.0393 3.48781 9.09882 3.53656C5.95033 3.61566 4.37608 3.65521 3.24495 4.79065C2.11382 5.92608 2.08114 7.45885 2.01576 10.5244C1.99474 11.5101 1.99475 12.4899 2.01577 13.4756Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  contrast: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12.002" r="10" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M14.9097 18.3695C17.3232 17.265 19 14.8288 19 12.001C19 9.17321 17.3232 6.73703 14.9097 5.63253C13.8893 5.16557 13.3791 4.93208 12.6895 5.37484C12 5.81759 12 6.5454 12 8.00102V16.001C12 17.4566 12 18.1845 12.6895 18.6272C13.3791 19.07 13.8893 18.8365 14.9097 18.3695Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  lock:     `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" stroke="currentColor" stroke-width="1.5"/><path d="M12 13C13.1046 13 14 12.1046 14 11C14 9.89543 13.1046 9 12 9C10.8954 9 10 9.89543 10 11C10 12.1046 10.8954 13 12 13ZM12 13L12 16" stroke="currentColor" stroke-linecap="round" stroke-width="1.5"/></svg>`,
  braces:   `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8 3C7.5355 3 7.30325 3 7.10891 3.03078C6.03918 3.20021 5.20021 4.03918 5.03078 5.10891C5 5.30325 5 5.5355 5 6L5 10C5 11.1046 4.10457 12 3 12C4.10406 11.9982 5 12.8928 5 13.9968V18C5 18.4645 5 18.6968 5.03078 18.8911C5.20021 19.9608 6.03918 20.7998 7.10891 20.9692C7.30325 21 7.5355 21 8 21" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M16 3C16.4645 3 16.6968 3 16.8911 3.03078C17.9608 3.20021 18.7998 4.03918 18.9692 5.10891C19 5.30325 19 5.5355 19 6L19 10C19 11.1046 19.8954 12 21 12C19.8959 11.9982 19 12.8928 19 13.9968V18C19 18.4645 19 18.6968 18.9692 18.8911C18.7998 19.9608 17.9608 20.7998 16.8911 20.9692C16.6968 21 16.4645 21 16 21" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  search:   `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17 17L21 21" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19C15.4183 19 19 15.4183 19 11Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  palette:  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C12.8417 22 14 22.1163 14 21C14 20.391 13.6832 19.9212 13.3686 19.4544C12.9082 18.7715 12.4523 18.0953 13 17C13.6667 15.6667 14.7778 15.6667 16.4815 15.6667C17.3334 15.6667 18.3334 15.6667 19.5 15.5C21.601 15.1999 22 13.9084 22 12Z" stroke="currentColor" stroke-width="1.5"/><circle cx="9.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/><circle cx="16.5" cy="9.5" r="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M7.125 15H7M7.25 15C7.25 15.1381 7.13807 15.25 7 15.25C6.86193 15.25 6.75 15.1381 6.75 15C6.75 14.8619 6.86193 14.75 7 14.75C7.13807 14.75 7.25 14.8619 7.25 15Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  sparkles: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 2L15.5387 4.39157C15.9957 6.42015 17.5798 8.00431 19.6084 8.46127L22 9L19.6084 9.53873C17.5798 9.99569 15.9957 11.5798 15.5387 13.6084L15 16L14.4613 13.6084C14.0043 11.5798 12.4202 9.99569 10.3916 9.53873L8 9L10.3916 8.46127C12.4201 8.00431 14.0043 6.42015 14.4613 4.39158L15 2Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/><path d="M7 12L7.38481 13.7083C7.71121 15.1572 8.84275 16.2888 10.2917 16.6152L12 17L10.2917 17.3848C8.84275 17.7112 7.71121 18.8427 7.38481 20.2917L7 22L6.61519 20.2917C6.28879 18.8427 5.15725 17.7112 3.70827 17.3848L2 17L3.70827 16.6152C5.15725 16.2888 6.28879 15.1573 6.61519 13.7083L7 12Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  table:    `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20 10C20 10 22.375 11.8222 21.375 14.6667C20.375 17.5111 21.375 19.4074 22 20M20 10H4M20 10V4M4 10C4 10 1.625 11.8222 2.625 14.6667C3.625 17.5111 2.625 19.4074 2 20M4 10V4M22 4H20.75H20M2 4H3.25H4M4 4H20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M11 7H13" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
  timer:    `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M20.5 12.5C20.5 17.1944 16.6944 21 12 21C7.30558 21 3.5 17.1944 3.5 12.5C3.5 7.80558 7.30558 4 12 4C16.6944 4 20.5 7.80558 20.5 12.5Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M5.88 18.7031L3.5 21.0031" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M18.14 18.668L20.5 20.998" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M5 3L2 6" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M22 6L19 3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/><path d="M12 8V12.5L14 14.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>`,
};

const tools: {
  title: string; category: 'security'|'design'|'develop'|'data'|'productivity';
  href: string; available: boolean; illustrationKey: string;
  illustrationActive?: string; icon: string;
}[] = [
  { title: 'Password Tools',  category: 'security', href: '/tools/password-tools',  available: true, illustrationKey: 'password_tools',
    illustrationActive: '/Cards/password_tools_active1.svg',                                                                                   icon: icon.key      },
  { title: 'Color Converter', category: 'design',   href: '/tools/color-converter', available: true, illustrationKey: '',                       icon: icon.palette  },
  { title: 'Pomodoro timer', category: 'productivity', href: '/tools/pomodoro', available: true, illustrationKey: '', icon: icon.timer}
];
---

<Layout title="Tools">
  <div class="max-w-6xl mx-auto px-6 pb-16">

    <!-- Filter pills — Lucide icons at 13×13 via viewBox="0 0 24 24" -->
    <div class="flex items-center justify-center flex-wrap gap-2 mb-8" id="filter-row">
      {categories.map((cat, i) => (
        <FilterPill
          label={cat.label}
          value={cat.value}
          color={cat.color}
          active={i === 0}
        />
      ))}
    </div>

    <!-- Tool grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[repeat(4,280px)] gap-4 justify-center" id="tool-grid">
      {tools.map(tool => (
        <ToolCard
          title={tool.title}
          category={tool.category}
          href={tool.href}
          available={tool.available}
          illustrationKey={tool.illustrationKey}
          illustrationActive={tool.illustrationActive}
        >
          <Fragment slot="icon" set:html={tool.icon} />
          {tool.title === 'Hash Calculator' && (
            <div
              slot="illustration"
              class="absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100"
              set:html={hashActiveSvg}
            />
          )}
          {tool.title === 'Password Tools' && (
            <div
              slot="illustration"
              class="absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100"
              set:html={pwAnimSvg}
            />
          )}
          {tool.title === 'Email Analyzer' && (
            <div
              slot="illustration"
              class="absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100"
              set:html={emailActiveSvg}
            />
          )}
          {tool.title === 'Color Contrast' && (
            <div
              slot="illustration"
              class="absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100"
              set:html={ccActiveSvg}
            />
          )}
          {tool.title === 'Color Converter' && (
            <div slot="illustration" class="absolute inset-0">
              <div class="absolute inset-0 transition-opacity duration-300 opacity-100 group-hover:opacity-0" set:html={ccvIdleSvg} />
              <div class="absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100" set:html={ccvAnimSvg} />
            </div>
          )}
          {tool.title === 'Pomodoro timer' && (
            <div slot="illustration" class="absolute inset-0 p-6">
              <img src="/Cards/pomodoro_idle.svg" alt="" class="absolute inset-0 w-full h-full object-contain p-2 transition-opacity duration-300 opacity-100 group-hover:opacity-0" />
              <div class="absolute inset-0 p-2 transition-opacity duration-300 opacity-0 group-hover:opacity-100" set:html={pomodoroActiveSvg} />
            </div>
          )}
        </ToolCard>
      ))}
    </div>

    <NotifySection client:only="react" />

  </div>
</Layout>

<script>
  import gsap from 'gsap';

  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const cards = document.querySelectorAll<HTMLElement>('.tool-card');

  // ── Helpers ──────────────────────────────────────────────────────────────────

  function drawPath(path: SVGPathElement, reverse = false, delay = 0) {
    const len = path.getTotalLength();
    gsap.set(path, {
      strokeDasharray: len,
      strokeDashoffset: reverse ? -len : len,
    });
    gsap.to(path, { strokeDashoffset: 0, duration: 1.0, ease: 'power2.out', delay });
  }

  function resetPaths(pill: HTMLButtonElement) {
    pill.querySelectorAll<SVGPathElement>('path').forEach(p =>
      gsap.set(p, { clearProps: 'strokeDasharray,strokeDashoffset' })
    );
  }

  function animateIllustration(pill: HTMLButtonElement) {
    const category = pill.dataset.filter!;
    const paths    = Array.from(pill.querySelectorAll<SVGPathElement>('path'));
    if (!paths.length) return;

    switch (category) {
      case 'all':
      case 'design':
      case 'productivity':
        drawPath(paths[0]);
        break;
      case 'data':
        paths.forEach((p, i) => drawPath(p, false, i * 0.1));
        break;
      case 'develop':
        drawPath(paths[0], true);
        drawPath(paths[1], true);
        break;
      case 'security':
        drawPath(paths[0]);
        drawPath(paths[1]);
        break;
    }
  }

  function activatePill(pill: HTMLButtonElement) {
    const illus = pill.querySelector<HTMLElement>('[data-illustration]');
    const span  = pill.querySelector<HTMLSpanElement>('span');
    if (illus) gsap.set(illus, { opacity: 1 });
    if (span) {
      span.style.fontWeight = '900';
      span.style.fontStyle  = 'italic';
      gsap.fromTo(span,
        { scale: 0.82, opacity: 0.5 },
        { scale: 1, opacity: 1, duration: 0.35, ease: 'back.out(2)' }
      );
    }
    animateIllustration(pill);
  }

  function deactivatePill(pill: HTMLButtonElement) {
    const illus = pill.querySelector<HTMLElement>('[data-illustration]');
    const span  = pill.querySelector<HTMLSpanElement>('span');
    if (illus) gsap.to(illus, { opacity: 0.25, duration: 0.2 });
    if (span) {
      span.style.fontWeight = '600';
      span.style.fontStyle  = 'normal';
    }
    resetPaths(pill);
  }

  // ── Click handler ─────────────────────────────────────────────────────────────

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      const category = pill.dataset.filter!;

      pills.forEach(p => {
        p.dataset.filter === category ? activatePill(p) : deactivatePill(p);
      });

      cards.forEach(card => {
        const match = category === 'all' || card.dataset.category === category;
        (card as HTMLElement).style.display = match ? '' : 'none';
      });
    });
  });

  // ── Animate initial active pill on load ───────────────────────────────────────

  const initial = document.querySelector<HTMLButtonElement>('.filter-pill[data-filter="all"]');
  if (initial) animateIllustration(initial);

  // ── Password Tools card: Easy → Medium → Hard loop ──────────────────────────

  const pwAstEls = [
    document.querySelector<SVGPathElement>('#pw-ast-1'),
    document.querySelector<SVGPathElement>('#pw-ast-4'),
    document.querySelector<SVGPathElement>('#pw-ast-2'),
    document.querySelector<SVGPathElement>('#pw-ast-3'),
  ];
  const pwIconEls  = (['easy','medium','hard'] as const).map(n =>
    document.querySelector<SVGPathElement>(`#pw-icon-${n}`)
  );
  const pwLabelEls = (['easy','medium','hard'] as const).map(n =>
    document.querySelector<SVGPathElement>(`#pw-label-${n}`)
  );
  const pwColors = ['#23CE6B', '#FFDB4D', '#E63841'] as const;

  if (pwAstEls[0]) {
    gsap.set(pwIconEls, { transformBox: 'fill-box', transformOrigin: 'center' });
    gsap.set([pwIconEls[1], pwIconEls[2]], { scale: 0, opacity: 0 });
    gsap.set(pwAstEls, { transformBox: 'fill-box', transformOrigin: 'center' });
    gsap.set([pwLabelEls[1], pwLabelEls[2]], { y: 20, opacity: 0 });

    const HOLD = 1.1;
    const pwTL  = gsap.timeline({ repeat: -1, paused: true });

    function addPwSwap(from: number, to: number) {
      const color = pwColors[to];
      pwTL
        .to({}, { duration: HOLD })
        .to(pwAstEls, {
          y: -9, rotation: 14, scale: 1.1,
          stagger: 0.07, duration: 0.24, ease: 'back.out(2)',
        })
        .to(pwAstEls, { stroke: color, duration: 0.22 }, '-=0.16')
        .to(pwAstEls, {
          y: 0, rotation: 0, scale: 1,
          stagger: 0.07, duration: 0.42, ease: 'elastic.out(0.9, 0.4)',
        }, '-=0.1')
        .to(pwIconEls[from], { scale: 0, opacity: 0, duration: 0.18, ease: 'back.in(2)' }, '-=0.4')
        .to(pwIconEls[to],   { scale: 1, opacity: 1, duration: 0.22, ease: 'back.out(2.5)' })
        .to(pwLabelEls[from], { y: -20, opacity: 0, duration: 0.22, ease: 'power2.in' }, '<-0.1')
        .to(pwLabelEls[to],   { y:   0, opacity: 1, duration: 0.22, ease: 'power2.out' }, '<0.1');
    }

    addPwSwap(0, 1);
    addPwSwap(1, 2);
    addPwSwap(2, 0);

    const pwCard = document.querySelector<HTMLElement>('a[href="/tools/password-tools"]');
    if (pwCard) {
      pwCard.addEventListener('mouseenter', () => pwTL.restart());
      pwCard.addEventListener('mouseleave', () => {
        pwTL.pause();
        gsap.set(pwAstEls, { y: 0, rotation: 0, scale: 1, stroke: pwColors[0] });
        gsap.set(pwIconEls[0], { scale: 1, opacity: 1 });
        gsap.set([pwIconEls[1], pwIconEls[2]], { scale: 0, opacity: 0 });
        gsap.set(pwLabelEls[0], { y: 0, opacity: 1 });
        gsap.set([pwLabelEls[1], pwLabelEls[2]], { y: 20, opacity: 0 });
      });
    }
  }

  // ── Hash Calculator card: arrow draw + doc wiggle ─────────────────────────────

  const hashCard  = document.querySelector<HTMLElement>('a[href="/tools/hash-calculator"]');
  const hashArrow = document.querySelector<SVGPathElement>('#hash-arrow');
  const wiggleEls = gsap.utils.toArray<SVGElement>('#hash-pill, #hash-green-1, #hash-green-2, #hash-text');

  if (hashCard && hashArrow) {
    gsap.set(hashArrow, { clipPath: 'inset(0 0 0 100%)' });

    let wiggleTL: gsap.core.Timeline | null = null;
    if (wiggleEls.length) {
      wiggleEls.forEach(el => gsap.set(el, { transformOrigin: '50% 50%', transformBox: 'fill-box' }));
      wiggleTL = gsap.timeline({ repeat: -1, repeatDelay: 1.6, paused: true })
        .to(wiggleEls, { rotation: 3,    duration: 0.1,  ease: 'power1.inOut' })
        .to(wiggleEls, { rotation: -2.5, duration: 0.1,  ease: 'power1.inOut' })
        .to(wiggleEls, { rotation: 1.5,  duration: 0.09, ease: 'power1.inOut' })
        .to(wiggleEls, { rotation: -1,   duration: 0.09, ease: 'power1.inOut' })
        .to(wiggleEls, { rotation: 0,    duration: 0.08, ease: 'power1.out'   });
    }

    hashCard.addEventListener('mouseenter', () => {
      gsap.to(hashArrow, {
        clipPath: 'inset(0 0 0 0%)',
        duration: 1.1,
        delay: 0.15,
        ease: 'power2.out',
      });
      wiggleTL?.restart();
    });
    hashCard.addEventListener('mouseleave', () => {
      gsap.set(hashArrow, { clipPath: 'inset(0 0 0 100%)' });
      wiggleTL?.pause();
      if (wiggleEls.length) gsap.set(wiggleEls, { rotation: 0 });
    });
  }

  // ── Color Contrast card: color-in wave + approach circle + spring back ─────────

  const ccShapes = ['cc-red','cc-green','cc-yellow','cc-blue']
    .map(id => document.querySelector<SVGPathElement>(`#${id}`));
  const ccCircle = document.querySelector<SVGCircleElement>('#cc-circle');

  if (ccShapes.every(s => s) && ccCircle) {
    gsap.set(ccShapes, {
      fill: '#131313', fillOpacity: 0.15,
      transformBox: 'fill-box', transformOrigin: 'center',
    });
    gsap.set(ccCircle, { transformBox: 'fill-box', transformOrigin: 'center' });

    const ccDx = [ 18,  17,  9, -2];
    const ccDy = [  0,   7, 15, 18];
    const colorMap = ['#E63841', '#23CE6B', '#FFDB4D', '#48ACF0'] as const;

    const ccTL = gsap.timeline({ repeat: -1, paused: true });

    ccTL
      .to(ccShapes[0]!, { fill: colorMap[0], fillOpacity: 1, duration: 0.3,  ease: 'power2.out' })
      .to(ccShapes[1]!, { fill: colorMap[1], fillOpacity: 1, duration: 0.3,  ease: 'power2.out' }, '-=0.15')
      .to(ccShapes[2]!, { fill: colorMap[2], fillOpacity: 1, duration: 0.3,  ease: 'power2.out' }, '-=0.15')
      .to(ccShapes[3]!, { fill: colorMap[3], fillOpacity: 1, duration: 0.3,  ease: 'power2.out' }, '-=0.15')
      .to({}, { duration: 0.28 });

    ccTL
      .to(ccShapes[0]!, { x: ccDx[0], y: ccDy[0], duration: 0.36, ease: 'power3.in' })
      .to(ccShapes[1]!, { x: ccDx[1], y: ccDy[1], duration: 0.36, ease: 'power3.in' }, '-=0.27')
      .to(ccShapes[2]!, { x: ccDx[2], y: ccDy[2], duration: 0.36, ease: 'power3.in' }, '-=0.27')
      .to(ccShapes[3]!, { x: ccDx[3], y: ccDy[3], duration: 0.36, ease: 'power3.in' }, '-=0.27')
      .to(ccCircle, { scale: 1.1, duration: 0.22, ease: 'power2.out' }, '-=0.18');

    ccTL
      .to(ccShapes[0]!, { x: 0, y: 0, duration: 0.55, ease: 'elastic.out(1.1, 0.45)' })
      .to(ccShapes[1]!, { x: 0, y: 0, duration: 0.55, ease: 'elastic.out(1.1, 0.45)' }, '-=0.48')
      .to(ccShapes[2]!, { x: 0, y: 0, duration: 0.55, ease: 'elastic.out(1.1, 0.45)' }, '-=0.48')
      .to(ccShapes[3]!, { x: 0, y: 0, duration: 0.55, ease: 'elastic.out(1.1, 0.45)' }, '-=0.48')
      .to(ccCircle,     { scale: 1,   duration: 0.45, ease: 'elastic.out(1.2, 0.5)'  }, '-=0.5')
      .to({}, { duration: 0.4 });

    ccTL
      .to(ccShapes[3]!, { fill: '#131313', fillOpacity: 0.15, duration: 0.22, ease: 'power2.in' })
      .to(ccShapes[2]!, { fill: '#131313', fillOpacity: 0.15, duration: 0.22, ease: 'power2.in' }, '-=0.12')
      .to(ccShapes[1]!, { fill: '#131313', fillOpacity: 0.15, duration: 0.22, ease: 'power2.in' }, '-=0.12')
      .to(ccShapes[0]!, { fill: '#131313', fillOpacity: 0.15, duration: 0.22, ease: 'power2.in' }, '-=0.12')
      .to({}, { duration: 0.18 });

    const ccCard = document.querySelector<HTMLElement>('[data-category="design"]');
    if (ccCard) {
      ccCard.addEventListener('mouseenter', () => ccTL.restart());
      ccCard.addEventListener('mouseleave', () => {
        ccTL.pause();
        gsap.set(ccShapes, { fill: '#131313', fillOpacity: 0.15, x: 0, y: 0 });
        gsap.set(ccCircle, { scale: 1 });
      });
    }
  }

  // ── Color Converter card: grid-morph loop ────────────────────────────────────
  const ccvCard   = document.querySelector<HTMLElement>('a[href="/tools/color-converter"]');
  const ccvPurple = document.querySelector<SVGRectElement>('#ccv-purple');

  if (ccvCard && ccvPurple) {
    const eIn  = 'power3.in';
    const eOut = 'power2.out';
    const eSpr = 'elastic.out(1, 0.45)';
    const DUR  = 0.36;
    const HOLD = 1.0;

    const ccvTL = gsap.timeline({ repeat: -1, paused: true });

    // A→B: Purple coils+snaps → Teal springs wide (sequential: no overlap)
    ccvTL
      .to('#ccv-purple', { attr: { height: 50  }, duration: DUR * 0.6, ease: eIn })
      .to('#ccv-teal',   { attr: { width: 108  }, duration: DUR * 1.6, ease: eSpr }, '>+0')
      .to({}, { duration: HOLD })

    // B→C: Coral escapes left first → HotPink springs down (Teal snaps back)
      .to('#ccv-teal',  { attr: { width: 50   }, duration: DUR * 0.6,  ease: eIn })
      .to('#ccv-coral', { attr: { x: 138      }, duration: DUR * 0.75, ease: 'power3.out' }, '+=0.04')
      .to('#ccv-hot',   { attr: { height: 108 }, duration: DUR * 1.6,  ease: eSpr }, '<0.12')
      .to({}, { duration: HOLD })

    // C→D: HotPink coils+snaps → Sky springs tall (sequential: no overlap)
      .to('#ccv-hot', { attr: { height: 50         }, duration: DUR * 0.6, ease: eIn })
      .to('#ccv-sky', { attr: { y: 65, height: 108 }, duration: DUR * 1.6, ease: eSpr }, '>+0')
      .to({}, { duration: HOLD })

    // D→E: cascade escapes first → Red springs wide
      .to('#ccv-sky',   { attr: { y: 123, height: 50 }, duration: DUR * 0.6,  ease: eIn })
      .to('#ccv-green', { attr: { y: 65             }, duration: DUR * 0.6,  ease: 'power3.out' }, '+=0.04')
      .to('#ccv-teal',  { attr: { x: 138            }, duration: DUR * 0.85, ease: eOut }, '<0')
      .to('#ccv-coral', { attr: { x: 196            }, duration: DUR * 0.85, ease: eOut }, '<0.06')
      .to('#ccv-red',   { attr: { width: 108        }, duration: DUR * 1.6,  ease: eSpr }, '<0.06')
      .to({}, { duration: HOLD })

    // E→A: Red snaps fast → Teal escapes left → Green returns → Purple springs tall
      .to('#ccv-red',    { attr: { width: 50   }, duration: DUR * 0.5,  ease: 'power3.out' })
      .to('#ccv-teal',   { attr: { x: 80       }, duration: DUR * 0.7,  ease: 'power3.out' }, '+=0.04')
      .to('#ccv-green',  { attr: { y: 7        }, duration: DUR * 0.85, ease: eOut }, '<0.04')
      .to('#ccv-purple', { attr: { height: 108 }, duration: DUR * 1.6,  ease: eSpr }, '<0.2')
      .to({}, { duration: HOLD });

    function ccvReset() {
      gsap.set('#ccv-purple', { attr: { height: 108 } });
      gsap.set('#ccv-teal',   { attr: { x: 80, width: 50 } });
      gsap.set('#ccv-hot',    { attr: { height: 50 } });
      gsap.set('#ccv-coral',  { attr: { x: 196 } });
      gsap.set('#ccv-sky',    { attr: { y: 123, height: 50 } });
      gsap.set('#ccv-red',    { attr: { width: 50 } });
      gsap.set('#ccv-green',  { attr: { y: 7 } });
    }

    ccvCard.addEventListener('mouseenter', () => { ccvReset(); ccvTL.restart(); });
    ccvCard.addEventListener('mouseleave', () => { ccvTL.pause(); ccvReset(); });
  }

  // ── Email Analyzer card: draw-in + scan loop ──────────────────────────────────

  const emTexts = ['em-red','em-t1','em-t2','em-t3','em-green','em-t4','em-t5']
    .map(id => document.querySelector<SVGRectElement>(`#${id}`));
  const emRedEl    = document.querySelector<SVGRectElement>('#em-red');
  const emGreenEl  = document.querySelector<SVGRectElement>('#em-green');
  const emLens     = document.querySelector<SVGPathElement>('#em-lens');
  const emHandle   = document.querySelector<SVGPathElement>('#em-handle');
  const emMagnifier = document.querySelector<SVGGElement>('#em-magnifier');

  if (emLens && emHandle && emMagnifier && emTexts[0]) {
    gsap.set(emTexts, { transformBox: 'fill-box', transformOrigin: 'left center', scaleX: 0 });

    const lensLen   = emLens.getTotalLength();
    const handleLen = emHandle.getTotalLength();
    gsap.set(emLens,   { strokeDasharray: lensLen,   strokeDashoffset: lensLen,   strokeOpacity: 0 });
    gsap.set(emHandle, { strokeDasharray: handleLen, strokeDashoffset: handleLen, strokeOpacity: 0 });
    gsap.set(emMagnifier, { x: 0, y: 0 });

    const move = { duration: 0.85, ease: 'power2.inOut' } as const;

    const emTL = gsap.timeline({ repeat: -1, paused: true });

    emTL
      .to(emTexts, { scaleX: 1, stagger: 0.07, duration: 0.3, ease: 'power3.out' })
      .to(emLens,   { strokeOpacity: 1, strokeDashoffset: 0, duration: 0.65, ease: 'power2.out' }, '-=0.05')
      .to(emHandle, { strokeOpacity: 1, strokeDashoffset: 0, duration: 0.28, ease: 'power2.out' })
      .to({}, { duration: 0.35 });

    emTL
      .to(emMagnifier, { x: -22, y: -14, ...move })
      .to([emRedEl, emGreenEl], { fill: '#9A9A9A', duration: 0.22 }, '-=0.45')
      .to(emRedEl,              { fill: '#E63841', duration: 0.28 })
      .to(emGreenEl,            { fill: '#23CE6B', duration: 0.28 }, '<')
      .to({}, { duration: 0.35 })
      .to(emMagnifier, { x: -34, y: 6, ...move })
      .to({}, { duration: 0.4 })
      .to(emMagnifier, { x: -18, y: -6, ...move })
      .to([emRedEl, emGreenEl], { fill: '#9A9A9A', duration: 0.22 }, '-=0.45')
      .to(emRedEl,              { fill: '#E63841', duration: 0.28 })
      .to(emGreenEl,            { fill: '#23CE6B', duration: 0.28 }, '<')
      .to({}, { duration: 0.35 })
      .to(emMagnifier, { x: 0, y: 0, ...move });

    emTL
      .to([emLens, emHandle], { strokeOpacity: 0, duration: 0.3, ease: 'power2.in' })
      .to(emTexts, { scaleX: 0, stagger: 0.04, duration: 0.18, ease: 'power2.in' }, '<0.05');

    const emCard = document.querySelector<HTMLElement>('a[href="/tools/email-analyzer"]');
    if (emCard) {
      emCard.addEventListener('mouseenter', () => emTL.restart());
      emCard.addEventListener('mouseleave', () => {
        emTL.pause();
        gsap.set(emTexts, { scaleX: 0 });
        gsap.set(emLens,   { strokeDashoffset: lensLen,   strokeOpacity: 0 });
        gsap.set(emHandle, { strokeDashoffset: handleLen, strokeOpacity: 0 });
        gsap.set(emMagnifier, { x: 0, y: 0 });
      });
    }
  }

  // ── Pomodoro card: spin the clock hands while hovered ───────────────────────

  const pomoHandShort = document.querySelector<SVGPathElement>('#pomo-hand-short');
  const pomoHandLong  = document.querySelector<SVGPathElement>('#pomo-hand-long');
  const pomoCard      = document.querySelector<HTMLElement>('a[href="/tools/pomodoro"]');

  if (pomoHandShort && pomoHandLong && pomoCard) {
    // Rotate around the clock's own center point, in the SVG's coordinate system
    gsap.set([pomoHandShort, pomoHandLong], { svgOrigin: '117.555 94.6206' });

    const pomoTL = gsap.timeline({ repeat: -1, paused: true });
    pomoTL
      .to(pomoHandLong,  { rotation: 360, duration: 3, ease: 'none' }, 0)
      .to(pomoHandShort, { rotation: 360, duration: 8, ease: 'none' }, 0);

    pomoCard.addEventListener('mouseenter', () => pomoTL.restart());
    pomoCard.addEventListener('mouseleave', () => {
      pomoTL.pause();
      gsap.set([pomoHandShort, pomoHandLong], { rotation: 0 });
    });
  }

</script>
