---
import Layout from '../../components/layout/Layout.astro';
import PasswordTools from '../../components/tools/PasswordTools';
---

<Layout
  title="Password Tools"
  description="Generate strong passwords and check password strength — entirely in your browser."
>
  <div class="max-w-6xl mx-auto px-6">
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-700 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-gray-700 font-medium">Password Tools</span>
    </nav>
  </div>

  <PasswordTools client:load />
</Layout>
