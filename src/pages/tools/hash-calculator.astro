---
import Layout from '../../components/layout/Layout.astro';
import HashCalculator from '../../components/tools/HashCalculator';
---

<Layout
  title="Hash Calculator"
  description="Calculate MD5, SHA-1, SHA-256, and SHA-512 hashes from text or files — entirely in your browser."
>
  <div class="max-w-6xl mx-auto px-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-gray-700 transition-colors">Tools</a>
      <span>/</span>
      <span class="text-gray-700 font-medium">Hash Calculator</span>
    </nav>
  </div>

  <HashCalculator client:load />
</Layout>
